#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"

if ! command -v uv >/dev/null 2>&1; then
  echo "Perpetuum requires uv to manage its Python runtime." >&2
  exit 1
fi

exec uv run --project "$SCRIPT_DIR" python -m perpetuum_app.cli "$@"
